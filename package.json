{
  "name": "local-course-learning",
  "version": "1.1.0",
  "description": "CourseFlow — local course library, player and progress tracker",
  "main": "dist/main/main.js",
  "author": "Khalid Rahman Hanify",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "vite build && npm run build:main",
    "start": "electron .",
    "postinstall": "node scripts/rebuild-native.js",
    "icons": "node scripts/generate-icon.js",
    "pack": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "build": {
    "appId": "com.khalidrahman.courseflow",
    "productName": "CourseFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "Khalid Rahman Hanify",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CourseFlow",
      "artifactName": "CourseFlow Setup ${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^12.11.1",
    "canvas-confetti": "^1.9.4",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^1.61.0",
    "natural-compare": "^1.4.0",
    "subtitle": "^4.2.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
